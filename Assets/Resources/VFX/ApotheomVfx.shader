// Combat VFX (CombatVfx, VfxKit). One shader for every effect material, set up per material:
//   Ink:   alpha-blended; the shape is the ink colour (near black) with the vertex colour on its edges (texture R), and it
//          erodes away instead of fading (Dissolve: vertex alpha is how much is left, cut by the texture's noise, G).
//   Glow:  additive; the whole shape takes the vertex colour, Boost pushes it past the bloom threshold.
//   Paint: alpha-blended, the whole shape takes the vertex colour (strokes, decals, markers).
// Textures pack: R = edge band, G = dissolve noise, A = shape (Resources/VFX/Tex, generated by Art/VFX/vfx_textures.py).
Shader "Apotheom/VFX"
{
    Properties
    {
        _MainTex ("Texture (R edge, G noise, A shape)", 2D) = "white" {}
        _Color ("Tint", Color) = (1,1,1,1)
        _InkColor ("Ink colour", Color) = (0.05,0.04,0.06,1)
        _TintAll ("Tint the whole shape (1) or only its edge (0)", Range(0,1)) = 1
        _EdgeBoost ("Edge brightness", Float) = 1.6
        _Boost ("Colour boost (bloom)", Float) = 1
        _Dissolve ("Erode by vertex alpha (1) or fade (0)", Range(0,1)) = 0
        _DissolveSoftness ("Erode edge softness", Range(0.005,0.3)) = 0.04
        [Enum(UnityEngine.Rendering.BlendMode)] _SrcBlend ("Src blend", Float) = 5
        [Enum(UnityEngine.Rendering.BlendMode)] _DstBlend ("Dst blend", Float) = 10
        [Enum(UnityEngine.Rendering.CompareFunction)] _ZTest ("Z test", Float) = 4
    }
    SubShader
    {
        Tags { "RenderType"="Transparent" "Queue"="Transparent" "RenderPipeline"="UniversalPipeline" "IgnoreProjector"="True" "PreviewType"="Plane" }
        Blend [_SrcBlend] [_DstBlend]
        ZWrite Off
        ZTest [_ZTest]
        Cull Off

        Pass
        {
            Name "Unlit"
            Tags { "LightMode"="UniversalForward" }
            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #pragma multi_compile_instancing
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            TEXTURE2D(_MainTex); SAMPLER(sampler_MainTex);
            CBUFFER_START(UnityPerMaterial)
                float4 _MainTex_ST;
                half4 _Color;
                half4 _InkColor;
                half _TintAll, _EdgeBoost, _Boost, _Dissolve, _DissolveSoftness;
            CBUFFER_END

            struct Attributes { float4 positionOS : POSITION; float2 uv : TEXCOORD0; half4 color : COLOR; UNITY_VERTEX_INPUT_INSTANCE_ID };
            struct Varyings { float4 positionCS : SV_POSITION; float2 uv : TEXCOORD0; half4 color : COLOR; };

            Varyings vert (Attributes v)
            {
                Varyings o;
                UNITY_SETUP_INSTANCE_ID(v);
                o.positionCS = TransformObjectToHClip(v.positionOS.xyz);
                o.uv = TRANSFORM_TEX(v.uv, _MainTex);
                o.color = v.color * _Color;
                return o;
            }

            half4 frag (Varyings i) : SV_Target
            {
                half4 t = SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, i.uv);
                half shape = t.a;
                // Ink erodes: what is left (vertex alpha) cuts the noise; anything else fades.
                half eroded = saturate((t.g * 0.98 + 0.02 - (1.0h - i.color.a)) / _DissolveSoftness);
                half alpha = lerp(shape * i.color.a, shape * eroded, _Dissolve);
                half edge = saturate(t.r * _EdgeBoost);
                half3 inked = lerp(_InkColor.rgb, i.color.rgb * _Boost, edge);
                half3 rgb = lerp(inked, i.color.rgb * _Boost, _TintAll);
                return half4(rgb, alpha);
            }
            ENDHLSL
        }
    }
}
